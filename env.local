# ─────────────────────────────────────────────────────────
# Supabase environment variables for biggboss-fanvote
# ─────────────────────────────────────────────────────────
# Fill in the three values below, then save this file.
# Move/rename this file into your project's root folder
# (the same folder as package.json) as exactly: .env.local
# ─────────────────────────────────────────────────────────

# 1. Project URL
# Supabase Dashboard → gear icon (Settings) → API Keys → "Project URL"
# Looks like: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 2. Publishable key (this is your "Publishable key" in Supabase)
# Supabase Dashboard → Settings → API Keys → "Publishable key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Secret key (this is your "Secret key" in Supabase)
# Supabase Dashboard → Settings → API Keys → "Secret key"
# NEVER share this or put it in frontend code — server-side only.
SUPABASE_SERVICE_ROLE_KEY=
